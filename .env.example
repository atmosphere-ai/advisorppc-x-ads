# OAuth 2.0 user-context token with ads.read (and ads.write for mutations).
# Create an X developer app, request ads.read ads.write offline.access media.write.
X_ADS_ACCESS_TOKEN=

# Optional default account when the caller omits account_id.
X_ADS_ACCOUNT_ID=

# HTTP mode only.
PORT=3333
HOST=127.0.0.1
MCP_PATH=/mcp

# Scheduler (AdvisorPPC queue — X has no native schedule).
# HTTP auto-starts the worker unless set to 0.
# stdio: set 1 or run `npm run worker`.
# ADVISORPPC_SCHEDULER=1
# ADVISORPPC_JOBS_PATH=/var/lib/advisorppc/jobs/x-ads.json
# Digest agents POST snapshots here for Claude/ChatGPT/AdvisorPPC.
# ADVISORPPC_WEBHOOK_URL=

# Set 1 to allow ACTIVE creates without confirm_spend. Never set this in production.
X_ADS_ALLOW_UNCONFIRMED_SPEND=0
